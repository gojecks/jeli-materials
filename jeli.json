{
    "cli": {
        "packageManager": "npm"
    },
    "projects": {
        "fo-materials": {
            "sourceRoot": "libs/fo",
            "root": "libs/fo",
            "prefix": "fo",
            "output": {
                "generateMeta": true,
                "patterns": [
                    "UMD",
                    "MODULE"
                ],
                "folder": "dist/fo/",
                "styles": [
                    "libs/fo/src/global-styles/theme.scss",
                    "libs/fo/src/global-styles/typography.scss",
                    "libs/fo/src/global-styles/buttons.scss",
                    "libs/fo/src/global-styles/forms.scss",
                    "libs/fo/src/global-styles/alerts.scss",
                    "libs/fo/src/global-styles/nav.scss",
                    "libs/fo/src/global-styles/list-group.scss",
                    "libs/fo/src/global-styles/modal.scss",
                    "libs/fo/src/global-styles/dropdown.scss",
                    "libs/fo/src/global-styles/table.scss",
                    "libs/fo/src/global-styles/cards.scss",
                    "libs/fo/src/global-styles/misc.scss",
                    "libs/fo/src/global-styles/navbar.scss",
                    "libs/fo/src/global-styles/accordion.scss",
                    "libs/fo/src/global-styles/toast.scss",
                    "libs/fo/src/global-styles/offcanvas.scss",
                    "libs/fo/src/global-styles/carousel.scss",
                    "libs/fo/src/global-styles/breadcrumb.scss",
                    "libs/fo/src/global-styles/utilities.scss",
                    "libs/fo/src/global-styles/advanced.scss",
                    "libs/fo/src/global-styles/animations.scss"
                ],
                "files": {
                    "@jeli/materials": "index.js"
                },
                "doc": {
                    "source": "libs/fo/src",
                    "destination": "docs/fo",
                    "plugins": [{
                        "name": "esdoc-standard-plugin"
                    }]
                }
            },
            "buildOptions": {
                "compiledBindings": true,
                "sass": true
            },
            "resolve": {},
            "type": "library",
            "styling": "scss"
        }
    },
    "resolve": {
        "alias": {
            "@jeli/*": "../jeli-js/dist/",
            "@jeli/common/datetime": "../jeli-js/dist/common/datetime",
            "@jeli/helpers": "../js-helpers"
        }
    },
    "default": "fo-materials"
}